DEBUG=True
SECRET_KEY=change-me
# DATABASE_URL=postgres://...   (leave empty to use db.sqlite3)
# Production only (comma separated):
# CORS_ALLOWED_ORIGINS=https://admin.starprinting.in,https://staff.starprinting.in
# CSRF_TRUSTED_ORIGINS=https://admin.starprinting.in,https://staff.starprinting.in

# Web Push (notifications with the browser closed) + email fallback
# Create the keys once:  python manage.py generate_vapid_keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIM_SUB=mailto:you@yourdomain.in
# Links used inside the fallback emails:
# ADMIN_PORTAL_URL=https://admin.starprinting.in
# SHOP_PORTAL_URL=https://shop.starprinting.in
# VENDOR_PORTAL_URL=https://vendor.starprinting.in
# NOTIFY_EMAIL_FALLBACK=True
# Email sending (SMTP) - already used for password emails:
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
